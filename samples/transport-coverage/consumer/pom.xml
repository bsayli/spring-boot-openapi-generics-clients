<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>io.github.blueprint-platform.samples</groupId>
    <artifactId>transport-coverage-consumer</artifactId>
    <version>1.2.1</version>
    <packaging>jar</packaging>

    <name>transport-coverage-consumer</name>
    <description>Consumer application exercising the generated transport coverage client.</description>

    <properties>
        <java.version>21</java.version>
        <transport-coverage-client.version>1.2.1</transport-coverage-client.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.blueprint-platform.samples</groupId>
            <artifactId>transport-coverage-client</artifactId>
            <version>${transport-coverage-client.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>
                        io.github.blueprintplatform.samples.transportcoverage.consumer.TransportCoverageConsumerApplication
                    </mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
